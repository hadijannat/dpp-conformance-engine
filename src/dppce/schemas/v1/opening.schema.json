{
  "$defs": {
    "AuthorityClass": {
      "description": "Kept separate on purpose: a guidance item is never reported as a legal obligation.",
      "enum": [
        "legal_obligation",
        "standard_method",
        "implementation_contract",
        "guidance",
        "illustrative"
      ],
      "title": "AuthorityClass",
      "type": "string"
    },
    "ClaimLevel": {
      "description": "What a result may be cited as. Set by execution mode and review status.",
      "enum": [
        "none",
        "illustrative",
        "diagnostic",
        "reviewed"
      ],
      "title": "ClaimLevel",
      "type": "string"
    },
    "ExecutionStatus": {
      "description": "What happened to one test step. Only COMPLETED can carry pass or fail.",
      "enum": [
        "completed",
        "not_run",
        "skipped",
        "blocked",
        "unsupported",
        "manual_unavailable",
        "error"
      ],
      "title": "ExecutionStatus",
      "type": "string"
    },
    "InclusionProof": {
      "additionalProperties": false,
      "description": "An audit path of one leaf of a tree of a decision body (architecture section 11.2).\n\nNo field has a default: a writer states each value.",
      "properties": {
        "decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "index": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "key": {
          "description": "\"R:\" or \"T:\" plus an identifier, or a record identifier.",
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "label": {
          "enum": [
            "results",
            "records"
          ],
          "title": "Label",
          "type": "string"
        },
        "leaf": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequirementResult"
            },
            {
              "$ref": "#/$defs/TestResult"
            },
            {
              "$ref": "#/$defs/RecordCommitment"
            }
          ],
          "title": "Leaf"
        },
        "path": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 64,
          "title": "Path",
          "type": "array"
        },
        "root": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Root",
          "type": "string"
        },
        "schema_version": {
          "const": "dppce.proof/1",
          "title": "Schema Version",
          "type": "string"
        },
        "size": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "Size",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "decision_digest",
        "label",
        "key",
        "index",
        "size",
        "leaf",
        "path",
        "root"
      ],
      "title": "InclusionProof",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Modality": {
      "enum": [
        "mandatory",
        "recommended",
        "optional"
      ],
      "title": "Modality",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "A minimized record of what a check saw.\n\n``summary`` holds only what the verdict needs, for example field names and status codes.\nIt must not hold restricted payload values. Raw bytes stay in the encrypted recording.",
      "properties": {
        "acquired_at": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "title": "Acquired At",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "exchange",
            "artifact",
            "declaration",
            "derived"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Record Ids",
          "type": "array"
        },
        "summary": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Summary",
          "type": "object"
        },
        "test_purpose_id": {
          "title": "Test Purpose Id",
          "type": "string"
        },
        "transformations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Transformations",
          "type": "array"
        },
        "truncated": {
          "default": false,
          "title": "Truncated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "test_purpose_id",
        "kind",
        "acquired_at"
      ],
      "title": "Observation",
      "type": "object"
    },
    "OpenedRecord": {
      "additionalProperties": false,
      "description": "Every field of one record except the salt. Its RFC 8785 form is the plaintext of the commitment.\n\n``error`` is a string here: the models import nothing else of the engine.",
      "properties": {
        "acquired_at": {
          "title": "Acquired At",
          "type": "string"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "body": {
          "description": "Standard base64 of the raw body.",
          "title": "Body",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Error"
        },
        "headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Headers",
          "type": "array"
        },
        "kind": {
          "enum": [
            "http",
            "artifact"
          ],
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "record_id": {
          "pattern": "^r\\d{4,6}$",
          "title": "Record Id",
          "type": "string"
        },
        "redirects": {
          "items": {
            "type": "string"
          },
          "title": "Redirects",
          "type": "array"
        },
        "request_headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "title": "Request Headers",
          "type": "array"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Status"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "kind",
        "acquired_at",
        "method",
        "url",
        "role",
        "request_headers",
        "status",
        "headers",
        "body",
        "truncated",
        "error",
        "redirects",
        "attempts"
      ],
      "title": "OpenedRecord",
      "type": "object"
    },
    "PathResult": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Tri"
        },
        "path_id": {
          "title": "Path Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "path_id",
        "applicability",
        "verdict",
        "steps"
      ],
      "title": "PathResult",
      "type": "object"
    },
    "RecordCommitment": {
      "additionalProperties": false,
      "description": "Salted commitment to one raw record. The salt stays in the encrypted recording.",
      "properties": {
        "commitment": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Commitment",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        }
      },
      "required": [
        "record_id",
        "commitment"
      ],
      "title": "RecordCommitment",
      "type": "object"
    },
    "RequirementResult": {
      "additionalProperties": false,
      "description": "Applicability, execution, modality, and review status stay separate fields.",
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Tri"
        },
        "applicability_reason": {
          "title": "Applicability Reason",
          "type": "string"
        },
        "authority_class": {
          "$ref": "#/$defs/AuthorityClass"
        },
        "claim_level": {
          "$ref": "#/$defs/ClaimLevel"
        },
        "modality": {
          "$ref": "#/$defs/Modality"
        },
        "pack_id": {
          "title": "Pack Id",
          "type": "string"
        },
        "paths": {
          "default": [],
          "items": {
            "$ref": "#/$defs/PathResult"
          },
          "title": "Paths",
          "type": "array"
        },
        "requirement_id": {
          "title": "Requirement Id",
          "type": "string"
        },
        "retained": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Retained",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/ReviewStatus"
        },
        "testability": {
          "$ref": "#/$defs/Testability"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "verdict_reason": {
          "title": "Verdict Reason",
          "type": "string"
        }
      },
      "required": [
        "requirement_id",
        "pack_id",
        "authority_class",
        "modality",
        "review_status",
        "testability",
        "applicability",
        "applicability_reason",
        "verdict",
        "verdict_reason",
        "claim_level"
      ],
      "title": "RequirementResult",
      "type": "object"
    },
    "ReviewStatus": {
      "enum": [
        "placeholder",
        "draft-needs-review",
        "approved",
        "superseded",
        "withdrawn"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "major",
        "minor",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TestResult": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/Tri"
        },
        "applicability_reason": {
          "title": "Applicability Reason",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "execution_status": {
          "$ref": "#/$defs/ExecutionStatus"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Observations",
          "type": "array"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "title": "Requirement Ids",
          "type": "array"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "test_purpose_id": {
          "title": "Test Purpose Id",
          "type": "string"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        }
      },
      "required": [
        "test_purpose_id",
        "requirement_ids",
        "check",
        "applicability",
        "applicability_reason",
        "execution_status",
        "verdict",
        "severity",
        "reason_code",
        "message"
      ],
      "title": "TestResult",
      "type": "object"
    },
    "Testability": {
      "enum": [
        "automated",
        "manual",
        "mixed",
        "not_testable"
      ],
      "title": "Testability",
      "type": "string"
    },
    "Tri": {
      "description": "Three-valued outcome. Missing information is UNKNOWN, never FALSE.",
      "enum": [
        "true",
        "false",
        "unknown"
      ],
      "title": "Tri",
      "type": "string"
    },
    "Verdict": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "not_applicable",
        "error"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "$id": "urn:dppce:schema:v1:opening",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The salt and the plaintext of one record, for a disclosure to an entitled party (ADR 0009).\n\nIt holds the plaintext of a recorded exchange. Protect it as you protect the recording.",
  "properties": {
    "proof": {
      "$ref": "#/$defs/InclusionProof"
    },
    "record": {
      "$ref": "#/$defs/OpenedRecord"
    },
    "salt": {
      "description": "Standard base64 of the 32-byte salt.",
      "pattern": "^[A-Za-z0-9+/]{43}=$",
      "title": "Salt",
      "type": "string"
    },
    "schema_version": {
      "const": "dppce.opening/1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "record",
    "salt",
    "proof"
  ],
  "title": "RecordOpening",
  "type": "object"
}
