          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ],
      "default": "unknown",
      "title": "Signature Format"
    },
    "sut": {
      "$ref": "#/$defs/SutIdentity"
    }
  },
  "required": [
    "schema_version",
    "sut",
    "profile"
  ],
  "title": "ICS",
  "type": "object"
}
